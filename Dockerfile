#======================================
#Stage 1: Cashe dependencies
#======================================
FROM gradle:8.10-jdk21-alpine AS cache
RUN mkdir -p /home/gradle/cache_home
ENV GRADLE_USER_HOME=/home/gradle/cache_home

#copy only the files needed to resolve dependencies
#use .kt since using kotlin DSL
COPY build.gradle.kts gradle.properties settings.gradle.kts /home/gradle/app/

WORKDIR /home/gradle/app
RUN gradle dependencies --no-daemon

#================================================
#Stage 2: Build Appliaction
#================================================
FROM gradle:8.10-jdk21-alpine AS build

#Cashed dependencies from stage 1
COPY --from=cache /home/gradle/cache_home /home/gradle/.gradle
COPY --chown=gradle:gradle . /home/gradle/src
WORKDIR /home/gradle/src

#Build the fat JAR
RUN gradle buildFatJar --no-daemon

#========================================
#Stage 3: Create the runtime Image
#========================================
FROM eclipse-temurin:21-jre-alpine AS runtime

EXPOSE 8080
RUN mkdir /app

#Grab the "-all.jar" generated by ktor rename to server.jar
COPY --from=build /home/gradle/src/build/libs/*-all.jar /app/server.jar

ENTRYPOINT ["java","-jar","/app/server.jar"]


